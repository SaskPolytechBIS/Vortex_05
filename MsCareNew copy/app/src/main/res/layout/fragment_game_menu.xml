<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#E3F2FD"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <TextView
        android:id="@+id/tvGameMenuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brain Power Games"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <!-- Neuro-Cycle -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNeuroCycle"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Neuro-Cycle"
        android:layout_marginBottom="16dp"/>

    <!-- Reaction Time -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReactionTime"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reaction Time"
        android:layout_marginBottom="16dp"/>

    <!-- Math Challenge -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMathChallenge"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Math Challenge"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMemoryMatch"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Memory Match"
        android:layout_marginTop="16dp"/>


</LinearLayout>
