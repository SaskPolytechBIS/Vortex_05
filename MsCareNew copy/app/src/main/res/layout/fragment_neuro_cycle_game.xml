<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- GIF Background (will be controlled programmatically) -->
    <ImageView
        android:id="@+id/gifBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/game_background"
        android:contentDescription="Animated background"/>

    <!-- Semi-transparent overlay for better text visibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"/>

    <!-- Your original game layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvColorPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowRadius="2"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowRadius="2"/>

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowRadius="2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnRed"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:text="RED"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF0000"
                android:layout_margin="8dp"
                android:elevation="8dp"
                android:textAllCaps="false"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnGreen"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:text="GREEN"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00FF00"
                android:layout_margin="8dp"
                android:elevation="8dp"
                android:textAllCaps="false"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnBlue"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:text="BLUE"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0000FF"
                android:layout_margin="8dp"
                android:elevation="8dp"
                android:textAllCaps="false"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>